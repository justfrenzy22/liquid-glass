{
  "name": "@justfrenzy/liquid-glass",
  "version": "0.2.0",
  "description": "React liquid glass components with desktop refraction, reflective Safari/mobile rendering, and optional HeroUI controls.",
  "type": "module",
  "license": "MIT",
  "author": "justfrenzy22",
  "repository": {
    "type": "git",
    "url": "https://github.com/justfrenzy22/liquid-glass.git"
  },
  "homepage": "https://github.com/justfrenzy22/liquid-glass#readme",
  "bugs": "https://github.com/justfrenzy22/liquid-glass/issues",
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "heroui",
    "safari",
    "components",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.js",
      "import": "./dist/index.browser.js",
      "default": "./dist/index.browser.js"
    },
    "./heroui": {
      "types": "./dist/types/heroui.d.ts",
      "browser": "./dist/heroui.browser.js",
      "node": "./dist/heroui.js",
      "import": "./dist/heroui.browser.js",
      "default": "./dist/heroui.browser.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./native": {
      "types": "./dist/types/native.d.ts",
      "browser": "./dist/native.browser.js",
      "node": "./dist/native.js",
      "import": "./dist/native.browser.js",
      "default": "./dist/native.browser.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/index.browser.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/components",
    "docs/getting-started.md",
    "docs/migration-0.2.md",
    "docs/native.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/*.browser.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-aria-components": "1.21.1",
    "react-aria": "3.52.1",
    "react-stately": "3.50.0",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@react-types/shared": "3.36.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm run docs:check && npm test && npm run test:build",
    "test:browser": "playwright test",
    "pack:local": "node scripts/pack.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:serve": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "test:build": "vite build",
    "docs:generate": "node scripts/generate-component-docs.mjs",
    "docs:check": "node scripts/check-component-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "react-aria-components": "1.21.1",
    "react-aria": "3.52.1",
    "react-stately": "3.50.0",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@react-types/shared": "3.36.1"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@internationalized/date": "3.12.4"
  }
}
